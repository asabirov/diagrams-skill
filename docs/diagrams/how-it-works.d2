# How the diagrams skill turns a request into a checked picture.
direction: down
(** -> **)[*].style.stroke: "#57606A"
(** <-> **)[*].style.stroke: "#57606A"
(** -> **)[*].style.font-size: 24
(** <-> **)[*].style.font-size: 24
**.style.font-size: 28

title: "How a request becomes a checked picture" {
  near: top-center
  shape: text
  style: {font-size: 40; bold: true; font-color: "#1F2328"}
}

classes: {
  # outside: people, browsers and other companies' systems
  outside: {style: {fill: "#ECEAE4"; stroke: "#6B675F"; font-color: "#1F2328"}}
  # way in: what first receives a request, such as a web app, API or queue
  way-in: {style: {fill: "#DCEAF7"; stroke: "#2F6596"; font-color: "#1F2328"}}
  # core: the services and jobs that do the work
  core: {style: {fill: "#DDF0E4"; stroke: "#2E7350"; font-color: "#1F2328"}}
  # records: databases, files and other stored data
  records: {style: {fill: "#F8EBCB"; stroke: "#8F6A12"; font-color: "#1F2328"}}
}

request: Someone asks\nfor a diagram {class: outside}
plan: Plan the message,\nview, size and names {class: way-in}
write: Write the D2 source\nin the house style {class: core}
render: Render it to PNG {class: core}
check: Picture shows the message,\nwith no layout defects? {shape: diamond; class: core}
share: Checked PNG\nand D2 source {class: records}

request -> plan
plan -> write
write -> render
render -> check
check -> share: yes
check -> write: no, fix the source
