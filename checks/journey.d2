# Online shop checkout: the example of a customer journey that starts at a person.
direction: down
(** -> **)[*].style.stroke: "#57606A"
(** <-> **)[*].style.stroke: "#57606A"
(** -> **)[*].style.font-size: 24
(** <-> **)[*].style.font-size: 24
**.style.font-size: 28

title: "Checkout: what the customer does" {
  near: top-center
  shape: text
  style: {font-size: 40; bold: true; font-color: "#1F2328"}
}

classes: {
  # outside: people, browsers and other companies' systems
  outside: {style: {fill: "#ECEAE4"; stroke: "#6B675F"; font-color: "#1F2328"}}
  # way in: what first receives a request, such as a web app, API or queue
  way-in: {style: {fill: "#DCEAF7"; stroke: "#2F6596"; font-color: "#1F2328"}}
  # core: the services and jobs that do the work
  core: {style: {fill: "#DDF0E4"; stroke: "#2E7350"; font-color: "#1F2328"}}
  # records: databases, files and other stored data
  records: {style: {fill: "#F8EBCB"; stroke: "#8F6A12"; font-color: "#1F2328"}}
}

customer: Customer {shape: person; class: outside}
basket: Opens\nthe basket {class: way-in}
address: Enters\nthe address {class: way-in}
pay: Pays\nby card {class: core}
done: Sees the\nconfirmation {class: core}
retry: Card declined,\ntries another card {class: outside}

customer -> basket -> address -> pay -> done
pay -> retry: declined
