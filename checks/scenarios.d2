# Scenarios: two variants of one system. Each scenario changes only what differs from the base board.
direction: right
(** -> **)[*].style.stroke: "#57606A"
(** <-> **)[*].style.stroke: "#57606A"
(** -> **)[*].style.font-size: 24
(** <-> **)[*].style.font-size: 24
**.style.font-size: 28

title: "Online shop: payment is up" {
  near: top-left
  shape: text
  style: {font-size: 40; bold: true; font-color: "#1F2328"}
}

classes: {
  outside: {style: {fill: "#ECEAE4"; stroke: "#6B675F"; font-color: "#1F2328"}}
  way-in: {style: {fill: "#DCEAF7"; stroke: "#2F6596"; font-color: "#1F2328"}}
  core: {style: {fill: "#DDF0E4"; stroke: "#2E7350"; font-color: "#1F2328"}}
  records: {style: {fill: "#F8EBCB"; stroke: "#8F6A12"; font-color: "#1F2328"}}
  group: {style: {fill: "#FAFAF8"; stroke: "#8C959F"; font-color: "#1F2328"}}
}

browser: Customer browser {class: outside}
orders: Orders service {class: core}
pay: Payment provider {class: outside}
db: Orders database {shape: cylinder; class: records}

browser -> orders: place order
orders -> pay: charge card
orders -> db: save order

scenarios: {
  payment-down: {
    title.label: "Online shop: payment is down"
    retry: Retry queue {class: way-in}
    (orders -> pay)[0].label: charge fails
    orders -> retry: queue charge
  }
}
