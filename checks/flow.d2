# Online shop refund rule: the example of a flow with conditions.
direction: down
(** -> **)[*].style.stroke: "#57606A"
(** <-> **)[*].style.stroke: "#57606A"
(** -> **)[*].style.font-size: 24
(** <-> **)[*].style.font-size: 24
**.style.font-size: 28

title: "Refund: which request is approved" {
  near: top-center
  shape: text
  style: {font-size: 40; bold: true; font-color: "#1F2328"}
}

classes: {
  # outside: people, browsers and other companies' systems
  outside: {style: {fill: "#ECEAE4"; stroke: "#6B675F"; font-color: "#1F2328"}}
  # way in: what first receives a request, such as a web app, API or queue
  way-in: {style: {fill: "#DCEAF7"; stroke: "#2F6596"; font-color: "#1F2328"}}
  # core: the services and jobs that do the work
  core: {style: {fill: "#DDF0E4"; stroke: "#2E7350"; font-color: "#1F2328"}}
  # records: databases, files and other stored data
  records: {style: {fill: "#F8EBCB"; stroke: "#8F6A12"; font-color: "#1F2328"}}
}

request: Refund request {class: way-in}
shipped: Order shipped? {shape: diamond; class: core}
returned: Item returned? {shape: diamond; class: core}
refund: Refund the card {class: core}
cancel: Cancel the shipment\nand refund {class: core}
wait: Ask for\nthe return {class: outside}

request -> shipped
shipped -> cancel: no
shipped -> returned: yes
returned -> refund: yes
returned -> wait: no
