# Online shop data: the example of a data model with tables.
direction: down
(** -> **)[*].style.stroke: "#57606A"
(** <-> **)[*].style.stroke: "#57606A"
(** -> **)[*].style.font-size: 24
(** <-> **)[*].style.font-size: 24
**.style.font-size: 28

title: "Orders: which tables hold the data" {
  near: top-center
  shape: text
  style: {font-size: 40; bold: true; font-color: "#1F2328"}
}

classes: {
  # outside: people, browsers and other companies' systems
  outside: {style: {fill: "#ECEAE4"; stroke: "#6B675F"; font-color: "#1F2328"}}
  # way in: what first receives a request, such as a web app, API or queue
  way-in: {style: {fill: "#DCEAF7"; stroke: "#2F6596"; font-color: "#1F2328"}}
  # core: the services and jobs that do the work
  core: {style: {fill: "#DDF0E4"; stroke: "#2E7350"; font-color: "#1F2328"}}
  # records: databases, files and other stored data
  records: {style: {fill: "#F8EBCB"; stroke: "#8F6A12"; font-color: "#1F2328"}}
}

customers: {
  shape: sql_table
  style.fill: "#F8EBCB"
  style.font-color: "#1F2328"
  id: int {constraint: primary_key}
  email: varchar {constraint: unique}
}
orders: {
  shape: sql_table
  style.fill: "#F8EBCB"
  style.font-color: "#1F2328"
  id: int {constraint: primary_key}
  customer_id: int {constraint: foreign_key}
  status: varchar
}
order_items: {
  shape: sql_table
  style.fill: "#F8EBCB"
  style.font-color: "#1F2328"
  order_id: int {constraint: foreign_key}
  product: varchar
  quantity: int
}

orders.customer_id -> customers.id
order_items.order_id -> orders.id
